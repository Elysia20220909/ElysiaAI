# ==================== ElysiaAI Unified Production Dockerfile ====================
# Optimized for Ubuntu 26.04 context (using Python 3.12 and Bun)

FROM python:3.12-slim-bookworm

# 1. Install System Dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    curl \
    unzip \
    ca-certificates \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# 2. Install Bun
RUN curl -fsSL https://bun.sh/install | bash
ENV PATH="/root/.bun/bin:${PATH}"

WORKDIR /app

# 3. Install Python Dependencies
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# 4. Install Node Dependencies
COPY package.json ./
COPY bun.lock* ./
COPY packages/server/package.json packages/server/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN bun install

# 5. Copy Code and Assets
COPY . .
RUN chmod +x config/docker/start.sh

# 6. Final Environment Setup
ENV NODE_ENV=production
ENV PYTHONPATH=/app
ENV PORT=3000
ENV FASTAPI_PORT=8000

# 7. Startup
EXPOSE 3000 8000

CMD ["bash", "config/docker/start.sh"]
