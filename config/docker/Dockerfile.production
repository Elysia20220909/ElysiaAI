# ==================== ElysiaAI Unified Production Dockerfile ====================
# Optimized for Ubuntu 26.04 context (using Python 3.12 and Bun)

FROM python:3.12-slim-bookworm

# 1. Install System Dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    unzip \
    ca-certificates \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# 2. Install Bun
RUN curl -fsSL https://bun.sh/install | bash
ENV PATH="/root/.bun/bin:${PATH}"

WORKDIR /app

# 3. Install Python Dependencies
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# 4. Install Node Dependencies
COPY package.json ./
# Note: skipping bun.lock if it's strictly for local, but copying if it exists
COPY bun.lock* ./ 
RUN bun install

# 5. Copy Code and Assets
COPY . .

# 6. Final Environment Setup
ENV NODE_ENV=production
ENV PYTHONPATH=/app
ENV PORT=3000

# 7. Startup
EXPOSE 3000

# We use bun to run the server directly
CMD ["bun", "run", "server.ts"]
