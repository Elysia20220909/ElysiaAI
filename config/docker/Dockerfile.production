# ==================== ElysiaAI Unified Production Dockerfile ====================
# Single-stage robust build for maximum reliability (glibc/Debian based)

FROM python:3.11-bookworm

# 1. Install System Dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    unzip \
    ca-certificates \
    build-essential \
    libffi-dev \
    libssl-dev \
    cmake \
    pkg-config \
    libavcodec-dev \
    libavformat-dev \
    libavutil-dev \
    libavdevice-dev \
    libavfilter-dev \
    libswscale-dev \
    libswresample-dev \
    && rm -rf /var/lib/apt/lists/*

# 2. Install Bun
RUN curl -fsSL https://bun.sh/install | bash
ENV PATH="/root/.bun/bin:${PATH}"

WORKDIR /app

# 3. Install Python Dependencies
# We install these first to leverage caching
COPY python/requirements.txt ./
RUN pip install --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir cryptography==42.0.5

# 4. Install Node Dependencies
COPY package.json bun.lock ./
COPY packages/fl-ranking/package.json ./packages/fl-ranking/
COPY packages/game/package.json ./packages/game/
COPY packages/mobile/package.json ./packages/mobile/
COPY packages/sandbox-ui/package.json ./packages/sandbox-ui/
COPY packages/server/package.json ./packages/server/
COPY packages/shared/package.json ./packages/shared/
RUN bun install && bun add @libsql/linux-x64-gnu

# 5. Copy Code and Assets
COPY . .

# 6. Generate Prisma and Build
RUN bun prisma generate
RUN bun run build

# 7. Final Environment Setup
ENV NODE_ENV=production
ENV PYTHONPATH=/app
ENV PORT=3000
ENV PYTHON_PORT=8000

# 8. Startup Script
COPY config/docker/start.sh /app/start.sh
RUN sed -i 's/\r$//' /app/start.sh && chmod +x /app/start.sh

EXPOSE 3000 8000

CMD ["/app/start.sh"]
