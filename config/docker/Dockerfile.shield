# ==================== ElysiaAI Shield Agent ====================
# Sovereign Defense Monitoring Agent (Rust)
# Part of the Grand Design initiative.

FROM python:3.11-bookworm AS builder

# Install Rust toolchain
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    build-essential \
    libssl-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /build

# Copy manifest and dummy source for dependency caching
COPY packages/shield-agent/Cargo.toml ./
RUN mkdir src && echo "fn main() {}" > src/main.rs
RUN cargo build --release
RUN rm -f target/release/deps/shield_agent*

# Copy actual source
COPY packages/shield-agent/src ./src
RUN cargo build --release

# Final Image
FROM python:3.11-bookworm

WORKDIR /app

# Copy binary from builder
COPY --from=builder /build/target/release/shield-agent ./

# Ensure logs and config directories exist
RUN mkdir -p /app/logs /app/config/defense

# Run the agent
CMD ["./shield-agent"]
