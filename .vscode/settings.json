{
  // Elysia AI - VS Code Settings
  "C_Cpp.default.compilerPath": "c:\\Users\\hosih\\elysia-ai\\cuda\\src\\similarity.cu",

  // Python
  "python.testing.unittestArgs": ["-v", "-s", ".", "-p", "*test.py"],
  "python.testing.pytestEnabled": false,
  "python.testing.unittestEnabled": true,
  "python.defaultInterpreterPath": "${workspaceFolder}/python/venv/bin/python",
  "python.analysis.extraPaths": ["${workspaceFolder}/python"],

  // Editor
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "biomejs.biome",
  "editor.codeActionsOnSave": {
    "source.fixAll.biome": "explicit"
  },

  // TypeScript
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,

  // Language Formatters
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[json]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  // Files
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/node_modules": false,
    "**/.git": true,
    "**/dist": true,
    "**/.dockerignore": true,
    "**/.editorconfig": true,
    "**/.env*": true,
    "**/.gitattributes": true,
    "**/.gitignore": true,
    "**/.husky": true,
    "**/.npmrc": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/.yarnrc.yml": true,
    "**/biome.json": true,
    "**/bunfig.toml": true,
    "**/postcss.config.cjs": true,
    "**/pyproject.toml": true,
    "**/requirements.lock": true,
    "**/requirements.txt": true,
    "**/ruff.toml": true,
    "**/tailwind.config.js": true,
    "**/tsconfig.json": true,
    "**/bun.lock": true,
    "**/.cleanignore": true
  },

  // Search
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/__pycache__": true
  },

  // Docker
  "docker.dockerComposeBuild": true,
  "docker.dockerComposeDetached": true,

  // Terminal
  "terminal.integrated.env.windows": {
    "NODE_ENV": "development"
  },

  // Git
  "git.enableSmartCommit": true,
  "git.confirmSync": false,
  "markdown.validate.enabled": true,
  "prisma.pinToPrisma6": false,
  "containers.composeBuild": true,
  "containers.composeDetached": true
}
