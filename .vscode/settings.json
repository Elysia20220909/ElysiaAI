{
    "python.linting.enabled": true,
    "python.linting.ruffEnabled": true,
    "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
    "python.formatting.provider": "none",
    "[python]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
        }
    },
    "ruff.importStrategy": "fromEnvironment",
    "ruff.fixAll": true,
    "ruff.organizeImports": true,
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "explorer.fileNesting.patterns": {
        "package.json": "bun.lock, tsconfig.json, biome.json, .env*, .gitignore, .gitattributes, .editorconfig, bunfig.toml, pyproject.toml, ruff.toml, postcss.config.cjs, tailwind.config.js, requirements.txt, requirements.lock, .npmrc, .yarnrc.yml, .dockerignore, .cleanignore, .husky, Dockerfile*, docker-compose.yml, Makefile",
        "README.md": "README.*.md, LICENSE, CONTRIBUTING.md, AEGIS_LEDGER.md",
        "scripts/boot.ts": "sentinel_*.json, soul_shard.hash, dev.db"
    },
    "files.exclude": {
        "**/.mypy_cache": true,
        "**/.ruff_cache": true,
        "kernel": true,
        "etc": true,
        "var": true,
        "usr": true,
        "scripts": true,
        "node_modules": false,
        "**/.git": false
    },
    "files.watcherExclude": {
        "**/.venv/**": true,
        "**/node_modules/**": true,
        "**/src-tauri/target/**": true,
        "**/packages/server/scripts/infra/tools/**": true,
        "**/.tmp/**": true,
        "**/.ruff_cache/**": true,
        "**/.mypy_cache/**": true
    },
    "search.exclude": {
        "**/.venv": true,
        "**/node_modules": true,
        "**/src-tauri/target": true,
        "**/packages/server/scripts/infra/tools": true,
        "**/.tmp": true,
        "**/.ruff_cache": true,
        "**/.mypy_cache": true
    },
    "rust-analyzer.cargo.targetDir": true,
    "rust-analyzer.checkOnSave": false,
    "rust-analyzer.cargo.buildScripts.enable": false,
    "rust-analyzer.procMacro.enable": false,
    "rust-analyzer.linkedProjects": [
        "src-tauri/Cargo.toml",
        "packages/shield-agent/Cargo.toml"
    ],
    "rust-analyzer.files.exclude": [
        ".venv",
        "node_modules",
        ".tmp",
        "src-tauri/target",
        "packages/server/scripts/infra/tools"
    ],
    "files.encoding": "utf8",
    "files.eol": "\n",
    "files.autoGuessEncoding": true,
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    "terminal.integrated.env.windows": {
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8"
    }
}
