TZ=Asia/Tokyo
BIND_IP=10.10.20.30

DOMAIN_AI=ai.home.arpa
DOMAIN_HA=ha.home.arpa
DOMAIN_STATUS=status.home.arpa
DOMAIN_DASH=dash.home.arpa
DOMAIN_GIT=git.home.arpa
DOMAIN_N8N=n8n.home.arpa
DOMAIN_GRAFANA=grafana.home.arpa
DOMAIN_PROMETHEUS=prometheus.home.arpa

OLLAMA_BASE_URL=http://ollama:11434

WEBUI_SECRET_KEY=replace-with-openssl-rand-hex-32

GITEA_DB_PASSWORD=replace-with-openssl-rand-base64-32
N8N_DB_PASSWORD=replace-with-openssl-rand-base64-32
N8N_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32

GRAFANA_ADMIN_USER=elisia
GRAFANA_ADMIN_PASSWORD=replace-with-strong-password

BASIC_AUTH_USER=elisia
BASIC_AUTH_HASH=replace-with-caddy-hash-password-output

MQTT_USERNAME=homeassistant
MQTT_PASSWORD=replace-with-openssl-rand-base64-32

PUID=1000
PGID=1000

# Optional image pins. After the first stable build, replace tags with tested tags or digests.
CADDY_IMAGE=caddy:2
OLLAMA_IMAGE=ollama/ollama:latest
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:main
UPTIME_KUMA_IMAGE=louislam/uptime-kuma:1
DOCKER_SOCKET_PROXY_IMAGE=tecnativa/docker-socket-proxy:0.3.0
HOMEPAGE_IMAGE=ghcr.io/gethomepage/homepage:latest
POSTGRES_IMAGE=postgres:16-alpine
GITEA_IMAGE=gitea/gitea:latest
N8N_IMAGE=docker.n8n.io/n8nio/n8n:latest
MOSQUITTO_IMAGE=eclipse-mosquitto:2
PROMETHEUS_IMAGE=prom/prometheus:latest
NODE_EXPORTER_IMAGE=prom/node-exporter:latest
GRAFANA_IMAGE=grafana/grafana:latest
