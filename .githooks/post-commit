#!/usr/bin/env sh

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
hook_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)" || exit 0

run_notify() {
	script_path="$repo_root/$1"

	if [ ! -f "$script_path" ]; then
		script_path="$hook_dir/../$1"
	fi

	[ -f "$script_path" ] || return 0

	if command -v bun >/dev/null 2>&1; then
		(cd "$repo_root" && bun "$script_path" --hook) >/dev/null 2>&1 || true
	elif command -v bun.exe >/dev/null 2>&1; then
		(cd "$repo_root" && bun.exe "$script_path" --hook) >/dev/null 2>&1 || true
	elif command -v powershell.exe >/dev/null 2>&1; then
		powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "Set-Location -LiteralPath \"$repo_root\"; bun \"$script_path\" --hook" >/dev/null 2>&1 || true
	elif command -v pwsh >/dev/null 2>&1; then
		pwsh -NoProfile -Command "Set-Location -LiteralPath \"$repo_root\"; bun \"$script_path\" --hook" >/dev/null 2>&1 || true
	fi
}

run_notify "scripts/slack-commit-notify.ts"
run_notify "scripts/discord-commit-notify.ts"
