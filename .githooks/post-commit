#!/usr/bin/env sh

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0

if command -v bun >/dev/null 2>&1; then
	(cd "$repo_root" && bun scripts/slack-commit-notify.ts --hook) >/dev/null 2>&1 || true
elif command -v bun.exe >/dev/null 2>&1; then
	(cd "$repo_root" && bun.exe scripts/slack-commit-notify.ts --hook) >/dev/null 2>&1 || true
elif command -v powershell.exe >/dev/null 2>&1; then
	powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "Set-Location -LiteralPath \"$repo_root\"; bun scripts/slack-commit-notify.ts --hook" >/dev/null 2>&1 || true
elif command -v pwsh >/dev/null 2>&1; then
	pwsh -NoProfile -Command "Set-Location -LiteralPath \"$repo_root\"; bun scripts/slack-commit-notify.ts --hook" >/dev/null 2>&1 || true
fi
