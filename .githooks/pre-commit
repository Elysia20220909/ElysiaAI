#!/usr/bin/env sh

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
script_path="$repo_root/scripts/auto-branch.ts"

[ -f "$script_path" ] || exit 0

if command -v bun >/dev/null 2>&1; then
	(cd "$repo_root" && bun "$script_path" --hook --allow-dirty) || exit 1
elif command -v bun.exe >/dev/null 2>&1; then
	(cd "$repo_root" && bun.exe "$script_path" --hook --allow-dirty) || exit 1
fi

exit 0
