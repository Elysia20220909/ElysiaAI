{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "elysia-os",
  "version": "0.1.0",
  "identifier": "com.elysia.ai",
  "build": {
    "frontendDist": "../",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "bun run server.ts",
    "beforeBuildCommand": "echo"
  },
  "app": {
    "windows": [
      {
        "title": "Elysia AI // Sovereign Resonance",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://raw.githubusercontent.com; connect-src 'self' http://localhost:3000 http://localhost:8000 ws://localhost:3000;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
        "../data/**/*",
        "../main.py",
        "../modules.py",
        "../requirements.txt",
        "../public/**/*"
    ]
  }
}
