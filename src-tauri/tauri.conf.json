{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "elysia-os",
  "version": "0.1.0",
  "identifier": "com.tauri.dev",
  "build": {
    "frontendDist": "../public",
    "devUrl": "http://localhost:3000/desktop.html",
    "beforeDevCommand": "echo",
    "beforeBuildCommand": "echo"
  },
  "app": {
    "windows": [
      {
        "title": "Elysia OS",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
        "../etc/**/*",
        "../usr/**/*",
        "../var/**/*",
        "../public/**/*",
        "../scripts/**/*"
    ]
  }
}
