# AWS CLI profile used by local scripts.
AWS_PROFILE=elysiaai

# Default AWS region for ElysiaAI assist resources.
ELYSIAAI_AWS_REGION=ap-northeast-1

# Backup bucket name. Use a globally unique bucket name in real AWS accounts.
ELYSIAAI_BACKUP_BUCKET=elysiaai-backup

# Optional KMS key ID or ARN for SSE-KMS uploads.
ELYSIAAI_BACKUP_KMS_KEY_ID=

# Required for client-side archive encryption.
# Use a long random value and do not commit real passphrases.
ELYSIAAI_BACKUP_PASSPHRASE=

# Example Secrets Manager names. Values live in AWS, not in this file.
ELYSIAAI_DISCORD_WEBHOOK_SECRET_NAME=/elysiaai/prod/discord/webhook
ELYSIAAI_GITHUB_TOKEN_SECRET_NAME=/elysiaai/prod/github/token
ELYSIAAI_OPENAI_API_KEY_SECRET_NAME=/elysiaai/prod/openai/api_key
ELYSIAAI_SLACK_WEBHOOK_SECRET_NAME=/elysiaai/prod/slack/webhook
