{
	"$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**/src/**/*.ts",
			"**/*.ts",
			"**/tests/**/*.ts",
			"!**/node_modules",
			"!**/dist",
			"!**/.venv",
			"!**/*.log",
			"!**/mobile",
			"!**/desktop",
			"!**/native",
			"!**/cuda",
			"!**/python",
			"!**/temp",
			"!**/elysia",
			"!**/src/**/*.d.ts",
			"!**/*.d.ts",
			"!**/public/assets/js",
			"!**/*.min.js",
			"!**/kernel",
			"!**/kernel/linux",
			"!**/docs/archive",
			"!**/public/standalone",
			"!**/prisma/client",
			"!**/.next",
			"!**/.cache",
			"!**/.turbo"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"suspicious": {
				"noExplicitAny": "off"
			},
			"complexity": {
				"noForEach": "off"
			},
			"style": {
				"noParameterAssign": "off",
				"noNonNullAssertion": "off"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } }
}
