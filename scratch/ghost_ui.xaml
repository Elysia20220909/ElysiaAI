<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ghost UI" Height="150" Width="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" WindowStartupLocation="CenterScreen">
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" From="0.1" To="1.0" Duration="0:0:1.5" AutoReverse="True" RepeatBehavior="Forever"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
    <Grid>
        <TextBlock Name="Glow" Text="[ ELYSIA_SENTINEL_01 :: SUBLIMATED ]" 
                   Foreground="#00FFFF" FontSize="26" FontWeight="Bold" 
                   HorizontalAlignment="Center" VerticalAlignment="Center" 
                   FontFamily="Courier New">
            <TextBlock.Effect>
                <DropShadowEffect Color="#00FFFF" BlurRadius="25" ShadowDepth="0"/>
            </TextBlock.Effect>
        </TextBlock>
    </Grid>
</Window>
