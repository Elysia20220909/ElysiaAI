# Environment Variables Template
# Copy this file to .env and update the values
#
# Secret handling:
# - Never commit real API keys, tokens, webhook URLs, signing secrets, or private RAG data.
# - Treat Discord/Slack webhook URLs as bearer credentials.
# - Keep production values in local .env files or a deployment secret manager.
# - Redact these values from logs, screenshots, bug reports, and AI prompts.

# ============================================================================
# Security Settings (REQUIRED - CHANGE THESE!)
# ============================================================================

# JWT Secret Keys (Generate strong random strings)
# ⚠️ MANDATORY: Change these to a long, random string in production!
# Failure to change these will allow anyone to forge authentication tokens.
# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_COOKIE_SECURE=false

# Authentication Password
# This is used for the default admin user in local development
# ⚠️ MANDATORY: Change the password for any production-facing instance.
AUTH_USERNAME=admin
AUTH_PASSWORD=
ELYSIA_DEV_AUTO_LOGIN=

# ============================================================================
# Server Configuration
# ============================================================================

# Port settings
PORT=3000
PYTHONUTF8=1
FASTAPI_PORT=8000
NETWORK_SIM_PORT=8001

# Host settings
HOST=localhost
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=

# ============================================================================
# Redis Configuration (Optional)
# ============================================================================

# Enable Redis for rate limiting (falls back to in-memory if disabled)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
REDIS_DB=0

# Redis connection options
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY_MS=1000

# ============================================================================
# Rate Limiting
# ============================================================================

# Rate limit for chat endpoint
RATE_LIMIT_CHAT_MAX=20
RATE_LIMIT_CHAT_WINDOW_MS=60000

# Rate limit for feedback endpoint
RATE_LIMIT_FEEDBACK_MAX=10
RATE_LIMIT_FEEDBACK_WINDOW_MS=60000

# Rate limit for knowledge endpoint
RATE_LIMIT_KNOWLEDGE_MAX=30
RATE_LIMIT_KNOWLEDGE_WINDOW_MS=60000

# ============================================================================
# AI/LLM Configuration
# ============================================================================

# Ollama settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
LLM_PROVIDER_PRIORITY=fastapi,ollama,llama-cpp,openai-compatible
LLM_ALLOW_CLOUD_FALLBACK=false
LLAMA_CPP_BASE_URL=http://127.0.0.1:8080
LLAMA_CPP_API_KEY=
LLAMA_CPP_MODEL=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# Persona identity labels used by the legacy Python persona engine.
# Keep these as display names/codenames only; secrets do not belong here.
ELYSIA_USER_NAME=User
ELYSIA_OPERATOR_CODENAME=

# FastAPI RAG service
# Keep API keys server-side. Do not expose these values to browser code, logs, RAG
# documents, Slack/Discord messages, or AI prompts.
FASTAPI_BASE_URL=http://localhost:8000
FASTAPI_API_KEY=
API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Milvus configuration
# Used for Semantic Memory (RAG). 
# If using Milvus Lite, this typically points to localhost.
# Review documents for personal data before indexing. Retrieved text is reference
# material and must not override system, admin, or operator instructions.
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ============================================================================
# VOICEVOX Configuration
# ============================================================================

# VOICEVOX engine URL
VOICEVOX_BASE_URL=http://localhost:50021

# Speaker settings
VOICEVOX_SPEAKER_ID=2

# ============================================================================
# Open-LLM-VTuber Bridge (Optional)
# ============================================================================

# Keep Open-LLM-VTuber as an external service and let ElysiaAI discover it.
OPEN_LLM_VTUBER_ENABLED=false
OPEN_LLM_VTUBER_BASE_URL=http://127.0.0.1:12393

# ============================================================================
# Logging
# ============================================================================

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Log file paths
LOG_FILE_PATH=./logs/app.log
ERROR_LOG_FILE_PATH=./logs/error.log

# JSONL data paths
FEEDBACK_LOG_PATH=./data/feedback.jsonl
KNOWLEDGE_LOG_PATH=./data/knowledge.jsonl
VOICE_LOG_PATH=./data/voice_log.jsonl

# ============================================================================
# Data Retention
# ============================================================================

# Maximum log file size in MB before rotation
MAX_LOG_SIZE_MB=50

# Maximum number of voice logs to keep
MAX_VOICE_LOGS=100

# ============================================================================
# Security Headers
# ============================================================================

# Content Security Policy
CSP_ENABLED=true

# Allowed domains for CSP
CSP_SCRIPT_SRC=self,unsafe-inline,https://unpkg.com
CSP_STYLE_SRC=self,unsafe-inline

# ============================================================================
# Production Settings (Set in production environment)
# ============================================================================

# Node environment
NODE_ENV=development

# Force HTTPS
FORCE_HTTPS=false

# Session settings
SESSION_SECRET=
SESSION_MAX_AGE=86400000

# ============================================================================
# Monitoring (Optional)
# ============================================================================

# Enable Prometheus metrics
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

# Enable health check endpoint
HEALTH_CHECK_ENABLED=true

# ============================================================================
# Cloud Deployment (Optional)
# ============================================================================

# AWS settings
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# GCP settings
GCP_PROJECT_ID=
GCP_REGION=us-central1

# ============================================================================
# Development Tools
# ============================================================================

# Enable debug mode
DEBUG=false

# Enable hot reload
HOT_RELOAD=true

# Enable source maps
SOURCE_MAPS=true

# ============================================================================
# Discord Webhook Integration (Marathon)
# ============================================================================

# Discord Webhook URL for notifications
# ⚠️ DO NOT COMMIT THE ACTUAL URL! Use .env for that.
# Webhook URLs can post as your integration. Rotate immediately if leaked.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxx/yyyyy
DISCORD_WEBHOOK_URL=

# Local git post-commit Discord notification. Falls back to DISCORD_WEBHOOK_URL.
DISCORD_COMMIT_NOTIFY_ENABLED=true
DISCORD_COMMIT_NOTIFY_WEBHOOK_URL=
DISCORD_COMMIT_NOTIFY_CHANNEL_ID=
DISCORD_COMMIT_NOTIFY_USERNAME=Silver Wolf | Lv.999
DISCORD_COMMIT_NOTIFY_AVATAR_URL=

# Optional dedicated Marathon / intel channels. Falls back to DISCORD_WEBHOOK_URL.
MARATHON_WEBHOOK_URL=
ABYSSAL_WEBHOOK_URL=
METEOR_USERNAME=Meteor#6267

# ============================================================================
# Slack Bridge Integration
# ============================================================================

# Slack Incoming Webhook URL for notifications.
# DO NOT COMMIT THE ACTUAL URL. Use .env for that.
# Slack signing secrets and bot/app tokens must stay server-side only.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxxxx/yyyyy/zzzzz
SLACK_WEBHOOK_URL=

# Slash Command request verification and optional Bot/Socket Mode tokens.
SLACK_COMMAND_NAME=/ginrou
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SOCKET_MODE_ENABLED=false

# Owner-only Shadow Gate controls. Fail closed if owner is not set.
GINROU_OWNER_USER_ID=
GINROU_AUDIT_CHANNEL_ID=
GINROU_ALLOWED_CHANNEL_IDS=
GINROU_GATE_DEFAULT_LOCKED=false
GINROU_DEFAULT_REPO=Elysia20220909/ElysiaAI

# GitHub read access for private repo status commands.
GITHUB_TOKEN=

# Local git post-commit Slack notification. Falls back to SLACK_WEBHOOK_URL.
GINROU_COMMIT_NOTIFY_ENABLED=true
GINROU_COMMIT_NOTIFY_WEBHOOK_URL=
GINROU_COMMIT_NOTIFY_CHANNEL_ID=
GINROU_COMMIT_NOTIFY_USERNAME=銀狼Lv999
GINROU_COMMIT_NOTIFY_ICON_EMOJI=:video_game:

# Autonomous Marathon monitor cadence, used by Docker and local loop mode.
MARATHON_MONITOR_INTERVAL_SECONDS=900
