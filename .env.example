# 🌸 Elysia AI - Environment Variables Example
# このファイルをコピーして .env を作成してください (cp .env.example .env)

# Server Configuration
PORT=3000

# Security (必ず本番環境では変更してください！)
JWT_SECRET=your_super_secret_jwt_key
JWT_REFRESH_SECRET=your_super_secret_refresh_key

# Basic Auth
AUTH_USERNAME=elysia
AUTH_PASSWORD=elysia-password

# AI & LLM Endpoints
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OPENAI_API_KEY=sk-your-api-key
OPENAI_MODEL=gpt-5.1-codex-max

# RAG & Vector DB (Python Backend)
FASTAPI_BASE_URL=http://localhost:8000

# Cache & Rate Limiting
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# Sovereign Defense (Grand Design)
AUDIT_LOG_DIR=./logs/audit
DEFENSE_RULES_FILE=./config/defense/rules.json

# Database
DATABASE_URL=file:./dev.db
