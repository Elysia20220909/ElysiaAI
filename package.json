{
  "name": "elysia-ai-monorepo",
  "version": "1.1.0",
  "author": "shinsati1234 <shinsati1234@gmail.com>",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun test",
    "dev": "bun --filter \"*\" dev",
    "start": "bun --filter @elysia-ai/server start",
    "build": "cd packages/server && bun build src/index.ts --outdir ../../dist --target node",
    "docker:build": "docker build -f Dockerfile.production -t elysia-ai:latest .",
    "docker:up": "docker-compose up -d",
    "aws:deploy": "bash cloud/aws/deploy.sh",
    "gcp:deploy": "bash cloud/gcp/deploy.sh",
    "lint": "biome check .",
    "format": "biome format --write .",
    "fix": "biome check --write .",
    "clean": "powershell -ExecutionPolicy Bypass -File ./scripts/clean.ps1 -Deep",
    "db:init": "bun --filter \"@elysia-ai/server\" db:init",
    "db:migrate": "bun --filter \"@elysia-ai/server\" db:migrate",
    "prepare": "husky",
    "tauri": "tauri",
    "dev:desktop": "tauri dev"
  },
  "lint-staged": {
    "*.{js,ts,tsx,json}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.py": [
      "python -m ruff check --fix --force-exclude",
      "python -m ruff format --force-exclude"
    ],
    "*": [
      "bun run scripts/security-scan.ts"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@playwright/test": "^1.58.2",
    "@tauri-apps/cli": "^2.10.1",
    "axios": "^1.13.6",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prisma": "5.12.0",
    "react-test-renderer": "19.2.3"
  },
  "dependencies": {
    "@prisma/client": "5.12.0"
  }
}
