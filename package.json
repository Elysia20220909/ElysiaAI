{
  "name": "elysia-ai",
  "version": "1.3.0",
  "author": "Elysia20220909",
  "license": "MIT OR Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "thrift": "^0.23.0"
  },
	"scripts": {
		"boot": "bun scripts/boot.ts",
		"boot:lite": "bun scripts/boot.ts --lite",
		"build": "bun build packages/server/src/index.ts --target=bun --outdir dist/server",
		"dev": "bun run --cwd packages/server dev",
		"dev:lite": "bun scripts/boot.ts --lite",
		"hooks:install": "git config core.hooksPath .githooks",
		"branch:auto": "bun scripts/auto-branch.ts",
		"morning": "bun scripts/morning-quick-check.ts",
		"notify:commit": "bun scripts/slack-commit-notify.ts --dry-run && bun scripts/discord-commit-notify.ts --dry-run",
		"notify:commit:slack": "bun scripts/slack-commit-notify.ts --dry-run",
		"notify:commit:discord": "bun scripts/discord-commit-notify.ts --dry-run",
		"start": "bun run --cwd packages/server start",
    "db:generate": "bun node_modules/prisma/build/index.js generate --schema prisma/schema.prisma",
    "db:validate": "bun node_modules/prisma/build/index.js validate --schema prisma/schema.prisma",
    "native:lite": "bun scripts/native-lite.ts",
    "ops": "bun scripts/local-ops.ts",
    "local-server:setup:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-server/Invoke-ElisiaLocalServerSetup.ps1",
    "local-server:setup:unix": "bash scripts/local-server/setup-elisia-local-server.sh",
    "local-server:host": "bun scripts/local-server/host-server-setup.ts",
    "local-server:host:start": "bun scripts/local-server/host-server-setup.ts --start",
    "agents": "bun scripts/agent-workbench.ts",
    "suit": "bun scripts/suit.ts",
    "dev:ci": "bun scripts/boot.ts --ci",
    "desktop": "bun tauri dev",
    "desktop:check": "bun scripts/tauri-distribution-check.ts",
    "desktop:build": "bun tauri build",
    "test": "bun test ./src/*.test.ts ./tests/*.test.ts ./tests/integration/*.test.ts ./tests/performance/*.test.ts ./packages/server/src/lib/*.test.ts",
    "lint": "bun node_modules/@biomejs/biome/bin/biome check .",
    "typecheck": "bun node_modules/typescript/bin/tsc --noEmit",
    "check:deps": "bun scripts/tests/check-dependency-alignment.ts",
    "check:encoding": "bun scripts/run-python.ts scripts/tests/check-encoding.py",
    "check:git-hygiene": "bun scripts/tests/check-git-hygiene.ts",
    "check:runner-policy": "bun scripts/tests/check-runner-policy.ts",
    "security:glassworm": "bun scripts/security/scan_glassworm.ts",
    "security:audit": "bun scripts/run-python.ts scripts/security/audit_dependencies.py"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/jwt": "latest",
    "@elysiajs/static": "^1.4.10",
    "@prisma/client": "^6.19.3",
    "elysia": "^1.4.28",
    "prisma": "^6.19.3",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@playwright/test": "^1.56.1",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/cli": "^2.11.0",
    "bun-types": "latest",
    "typescript": "^6.0.3"
  }
}
