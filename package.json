{
  "name": "elysia-ai",
  "version": "0.1.0",
  "scripts": {
    "dev": "bun run --watch packages/server/src/index.ts",
    "start": "bun run packages/server/src/index.ts",
    "desktop": "bun tauri dev",
    "test": "bun test",
    "lint": "bunx biome check . && python -m ruff check .",
    "ai:quick": "bun run lint",
    "ai:check": "bun run lint && bun run test",
    "ai:security": "bun audit"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/jwt": "latest",
    "@elysiajs/static": "^1.4.10",
    "@elysiajs/websocket": "latest",
    "@prisma/client": "latest",
    "elysia": "^1.4.28",
    "prisma": "latest"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/cli": "^2.10.1",
    "bun-types": "latest"
  }
}
