# 🌸 Elysia AI - Environment Variables Example
# このファイルをコピーして .env を作成してください (cp .env.example .env)

# --- [ Server Configuration ] ---
# アプリケーションのポート番号
PORT=3000

# --- [ Security ] ---
# セッション管理用のシークレットキー（必ず本番環境では変更してください！）
# 推奨: `openssl rand -base64 32` などで生成
JWT_SECRET=your_super_secret_jwt_key
JWT_REFRESH_SECRET=your_super_secret_refresh_key

# デフォルトの認証情報（開発用）
AUTH_USERNAME=elysia
AUTH_PASSWORD=elysia-password

# --- [ AI & LLM Endpoints ] ---
# ローカルLLM (Ollama) の設定
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# 外部LLM (OpenAI) の設定（オプション）
OPENAI_API_KEY=sk-your-api-key
OPENAI_MODEL=gpt-4o

# --- [ RAG & Vector DB (Python Backend) ] ---
# Python AI カーネルのベースURL
FASTAPI_BASE_URL=http://localhost:8000

# --- [ Cache & Rate Limiting ] ---
# Redisを有効にする場合は true に変更してください
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# --- [ Sovereign Defense (Grand Design) ] ---
# 監査ログの保存先
AUDIT_LOG_DIR=./logs/audit
# 防衛ルールの定義ファイル
DEFENSE_RULES_FILE=./config/defense/rules.json

# --- [ Database ] ---
# SQLite データベースのパス
DATABASE_URL=file:./dev.db
# --- [ Notification ] ---
# Discord Webhook URL for Sentinel Bot
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token
